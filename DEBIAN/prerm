#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "remove" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user --global disable 9OSGUIServer.service || true
        systemctl --user --global disable 9OSSystemAPI.service || true
        systemctl --user --global disable 9OSDesktopLayoutActivator.service || true
    fi
fi

exit 0
