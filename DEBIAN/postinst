#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "configure" ]; then

    # Rebuild the desktop database so the new .desktop entries are registered.
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi

    # Refresh the icon cache of the theme that received the new icons.
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi

    # Enable the 9OS user services for all users (they start on next login).
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user --global enable 9OSGUIServer.service || true
        systemctl --user --global enable 9OSSystemAPI.service || true
    fi

    # Make sure new users get the standard folders.
    for dir in Downloads Music Documents; do
        if [ ! -e "/etc/skel/$dir" ]; then
            mkdir -p /etc/skel
            mkdir -m 0755 "/etc/skel/$dir" || true
        fi
    done

    # Create the same folders for every existing regular user.
    if command -v getent >/dev/null 2>&1; then
        getent passwd | while IFS=: read -r user _ uid gid _ home shell; do
            [ "$uid" -ge 1000 ] || continue
            case "$shell" in
                */nologin|*/false) continue ;;
            esac
            case "$home" in
                /home/*) ;;
                *) continue ;;
            esac
            [ -d "$home" ] || continue
            for dir in Downloads Music Documents; do
                target="$home/$dir"
                if [ ! -e "$target" ]; then
                    install -d -m 0755 -o "$user" -g "$gid" "$target" 2>/dev/null || true
                fi
            done
        done
    fi

fi

exit 0
