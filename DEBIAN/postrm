#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas || true
    fi

    # Restore base-files' own /etc/os-release (undo the preinst diversion).
    dpkg-divert --package 9os-for-pc-syspkg --remove --rename --divert /etc/os-release.real /etc/os-release || true
fi

exit 0
